---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Portfólio Laís Duarte",
  description = "Conteúdo autêntico de UGC em skincare, moda, beleza e fitness.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealEls = document.querySelectorAll("[data-reveal]");

      // exposto pra quem insere [data-reveal] depois do load (ex.: os cards de vídeo que
      // chegam via fetch no cliente) conseguir registrar os elementos novos aqui também
      if (prefersReducedMotion) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
        window.observeReveal = (els: NodeListOf<Element> | Element[]) => els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
        window.observeReveal = (els: NodeListOf<Element> | Element[]) => els.forEach((el) => io.observe(el));
      }

      // SMIL ignores prefers-reduced-motion, so the wave morph has to be pulled manually
      if (prefersReducedMotion) {
        document.querySelectorAll(".checker-wave animate").forEach((el) => el.remove());
      }

      // o bloco (corpo + cabeça) e a cabeça balançam em tempos diferentes; os dois param juntos
      const wobbleEls = [...document.querySelectorAll(".cutout-wobble, .cutout-drift")];
      if (wobbleEls.length && !prefersReducedMotion) {
        const startY = window.scrollY;
        let timer;
        const stopWobble = () => {
          clearTimeout(timer);
          window.removeEventListener("scroll", onScroll);
          // hand the current tilt over to a transition so it eases to rest
          // instead of snapping back when the animation is removed
          wobbleEls.forEach((el) => {
            const tilted = getComputedStyle(el).transform;
            el.style.animation = "none";
            el.style.transform = tilted;
            void el.offsetWidth;
            el.style.transition = "transform 0.8s cubic-bezier(0.16, 0.84, 0.3, 1)";
            el.style.transform = "none";
          });
        };
        // the browser's scroll restoration fires a scroll event on load, which would
        // kill the wobble before the visitor ever touches the page
        const onScroll = () => {
          if (Math.abs(window.scrollY - startY) > 10) stopWobble();
        };
        timer = setTimeout(stopWobble, 5000);
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
