---
import Layout from '../layouts/Layout.astro';
import CheckerStrip from '../components/CheckerStrip.astro';

const navLinks = [
  { href: "#sobre", label: "Sobre" },
  { href: "#portfolio", label: "Portfólio" },
  { href: "#fotos", label: "Fotos" },
  { href: "#como-trabalho", label: "Como trabalho" },
  { href: "#contato", label: "Contato" },
];

// Estrelas decorativas: posição sorteada no build dentro de zonas que evitam o texto,
// alternando entre as zonas. O delay negativo faz cada uma começar num ponto diferente do giro.
type Zone = { left: [number, number]; top: [number, number]; show?: string };
const rand = (min: number, max: number) => Math.random() * (max - min) + min;
const scatterStars = (count: number, zones: Zone[]) =>
  Array.from({ length: count }, (_, i) => {
    const zone = zones[i % zones.length];
    return {
      show: zone.show ?? "sm:block",
      left: rand(...zone.left),
      top: rand(...zone.top),
      size: Math.round(rand(16, 40)),
      duration: +rand(7, 16).toFixed(1),
      delay: +(-rand(0, 12)).toFixed(1),
    };
  });
// a porcentagem sorteada vale dentro de uma área recuada 4rem de cada borda (já descontando
// o tamanho da estrela), pra nenhuma encostar na beirada e ser cortada pelo overflow da seção
const starStyle = (s: ReturnType<typeof scatterStars>[number]) =>
  `left:calc(4rem + (100% - 8rem - ${s.size}px) * ${(s.left / 100).toFixed(3)}); ` +
  `top:calc(4rem + (100% - 8rem - ${s.size}px) * ${(s.top / 100).toFixed(3)}); ` +
  `width:${s.size}px; height:${s.size}px; animation-duration:${s.duration}s; animation-delay:${s.delay}s;`;

const heroStars = scatterStars(8, [
  { left: [2, 46], top: [0, 3], show: "2xl:block" },
  { left: [52, 97], top: [3, 35] },
  { left: [2, 46], top: [98, 100], show: "2xl:block" },
  { left: [42, 48], top: [12, 88], show: "2xl:block" },
]);
const contactStars = scatterStars(10, [
  { left: [1, 18], top: [4, 90] },
  { left: [82, 97], top: [4, 90] },
]);

const funFacts = [
  "Mineira, de Belo Horizonte",
  "Tatuadora e empreendedora",
  "Praticante de Muay Thai",
  "Apaixonada por beleza e autocuidado",
];

const aboutPhotos: { src: string; alt: string }[] = [
  { src: "/images/lais-sobre-1.jpg", alt: "Laís Duarte" },
  { src: "/images/lais-sobre-2.jpg", alt: "Laís Duarte" },
];

// reels/vídeos do portfólio, fotos da galeria e posts de carrossel vêm do ugc-admin (fetch client-side no <script> lá
// embaixo, por PUBLIC_PROJECT_SLUG) — a seção mostra "em breve" enquanto não tiver nenhum
// nicho com vídeo cadastrado lá, e nunca quebra o site se o admin estiver fora do ar.

// números de performance — a seção "Resultados" só aparece quando tiver algo aqui.
const results: { brand: string; format: string; stats: { value: string; label: string }[] }[] = [];

const steps = [
  {
    title: "Briefing",
    text: "Entendo a marca, o produto, o público e o objetivo do vídeo — alcance, conversão ou anúncio.",
  },
  {
    title: "Roteiro",
    text: "Escrevo o gancho, as falas e as cenas e mando pra sua aprovação antes de gravar.",
  },
  {
    title: "Gravação e edição",
    text: "Gravo, edito com legenda e trilha e entrego no formato certo pra cada rede, pronto pra postar ou impulsionar.",
  },
];
---

<Layout title="Portfólio Laís Duarte" description="Conteúdo autêntico de UGC em skincare, moda, beleza e fitness.">
  <main class="overflow-x-clip bg-cream">
    <!-- HEADER -->
    <header class="sticky top-0 z-20 border-b border-ink/10 bg-cream/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="#" class="font-display text-lg font-extrabold tracking-tight">laisduarte.content</a>
        <nav class="hidden gap-8 sm:flex">
          {navLinks.map((l) => (
            <a href={l.href} class="font-display text-sm font-medium text-ink/70 hover:text-ink">{l.label}</a>
          ))}
        </nav>
        <a
          href="#contato"
          class="rounded-full bg-pink-dark px-5 py-2 font-display text-sm font-semibold text-cream transition-transform hover:-translate-y-0.5"
        >
          Trabalhe comigo
        </a>
      </div>
    </header>

    <!-- HERO -->
    <section class="relative flex flex-col overflow-hidden bg-pink-light pt-8 sm:min-h-[860px] sm:flex-row sm:items-end sm:justify-end sm:pt-0">
      {heroStars.map((s) => (
        <svg
          aria-hidden="true"
          viewBox="0 0 100 100"
          class={`star-spin pointer-events-none absolute hidden text-pink ${s.show}`}
          style={starStyle(s)}
        >
          <path
            d="M50 2L61.2 34.6L95.7 35.2L68.1 55.9L78.2 88.8L50 69L21.8 88.8L31.9 55.9L4.3 35.2L38.8 34.6Z"
            fill="currentColor"
          />
        </svg>
      ))}

      <!-- foto única (recorte já vem pronto, com a borda verde), parada, sem balanço -->
      <div class="relative h-[380px] w-full sm:h-[860px] sm:w-1/2">
        <img
          src="/images/lais-hero-cover.webp"
          alt="Laís Duarte, UGC creator"
          class="absolute inset-0 block h-full w-full object-contain object-bottom"
          loading="eager"
        />
      </div>

      <div class="relative z-10 mt-6 px-6 pb-12 text-center sm:absolute sm:inset-y-0 sm:left-0 sm:right-auto sm:mt-0 sm:flex sm:w-1/2 sm:flex-col sm:justify-center sm:pb-0 sm:pl-16 sm:pr-6 sm:text-left">
        <p class="font-display text-sm font-semibold tracking-[0.15em] text-pink-dark">CRIADORA UGC</p>
        <h1 class="mt-3 font-display text-[clamp(2.5rem,calc(19vw-0.6rem),3.75rem)] font-black leading-[0.95] text-sage-dark sm:text-[clamp(2.5rem,calc(9.4vw-1.1rem),6rem)]">
          <span data-hero-reveal style="animation-delay: 0ms;">LAÍS</span><br />
          <span data-hero-reveal style="animation-delay: 120ms;">DUARTE</span>
        </h1>
        <p class="mx-auto mt-6 max-w-sm text-lg text-ink/75 sm:mx-0">
          Conteúdo autêntico em skincare, beleza, moda e fitness — espontâneo, criativo e com a
          cara de quem realmente usa o produto.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3 sm:justify-start">
          <span class="rounded-full bg-cream px-4 py-1.5 font-display text-sm font-medium text-pink-dark">skincare</span>
          <span class="rounded-full bg-cream px-4 py-1.5 font-display text-sm font-medium text-pink-dark">moda</span>
          <span class="rounded-full bg-cream px-4 py-1.5 font-display text-sm font-medium text-pink-dark">beleza</span>
          <span class="rounded-full bg-cream px-4 py-1.5 font-display text-sm font-medium text-pink-dark">fitness</span>
        </div>
        <a
          href="#contato"
          class="mt-8 inline-block self-center rounded-full bg-sage-dark px-8 py-3 font-display text-sm font-semibold text-cream transition-transform hover:-translate-y-0.5 sm:self-start"
        >
          Trabalhe comigo
        </a>
      </div>
    </section>

    <!-- MARCAS PARCEIRAS -->
    <section class="bg-sage-dark pt-10 pb-24">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6">
        <p class="font-display text-xs font-semibold tracking-[0.15em] text-cream/70">MARCAS QUE JÁ CONFIARAM</p>
        <div class="flex flex-wrap items-center justify-center gap-10">
          <img src="/images/brand-trussfit.png" alt="Truss Fit" class="h-10 w-auto object-contain sm:h-12" loading="lazy" />
        </div>
      </div>
    </section>

    <CheckerStrip />

    <!-- SOBRE -->
    <section id="sobre" class="blur-grain py-24">
      <div class="relative z-10 mx-auto max-w-6xl px-6">
        <div data-reveal class="grid gap-6 text-xs leading-snug text-ink/60 sm:ml-auto sm:max-w-xl sm:grid-cols-3">
          <p>Conteúdo que conecta.<br />Resultado que converte.</p>
          <p>Siga as minhas<br />redes sociais</p>
          <p>@laisduarte.content<br />Belo Horizonte<br />Skincare, moda, beleza e fitness</p>
        </div>

        <div class="mt-16 grid items-end gap-12 lg:grid-cols-2 lg:gap-16">
          <div data-reveal>
            <h2 class="font-serif text-6xl italic leading-none text-sage-dark sm:text-8xl">Sobre mim</h2>

            <div class="mt-10 grid grid-cols-2 gap-6">
              {aboutPhotos.length > 0
                ? aboutPhotos.map((p) => (
                    <div class="relative">
                      <img
                        src={p.src}
                        alt={p.alt}
                        class="aspect-[3/4] w-full object-cover"
                        loading="lazy"
                      />
                      <span
                        aria-hidden="true"
                        class="absolute top-1/2 right-0 flex h-11 w-11 translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-ink font-display text-xl font-light text-cream"
                      >
                        +
                      </span>
                    </div>
                  ))
                : Array.from({ length: 2 }, (_, i) => (
                    <div
                      class={`flex aspect-[3/4] flex-col items-center justify-center gap-2 ${i % 2 === 0 ? "bg-pink-light text-pink-dark" : "bg-sage-light text-sage-dark"}`}
                    >
                      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path d="M4 8h3l1.5-2.5h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z" stroke-linejoin="round" />
                        <circle cx="12" cy="13.5" r="3.2" />
                      </svg>
                      <span class="font-display text-xs font-semibold">foto em breve</span>
                    </div>
                  ))}
            </div>
          </div>

          <div data-reveal style="--reveal-delay: 120ms;">
            <div class="text-justify text-xl leading-relaxed text-ink/80">
              <p>
                Eu sou a Laís, tenho 28 anos e sou de Belo Horizonte (MG). Sou comunicativa,
                extrovertida e tenho facilidade diante das câmeras — gosto de criar vídeos
                espontâneos, dinâmicos e autênticos, que aproximam as marcas das pessoas de um
                jeito leve e natural.
              </p>
              <p class="mt-4">
                Meu conteúdo transita entre skincare, beleza, moda e fitness, sempre buscando
                apresentar produtos de forma criativa, valorizar a experiência de uso e despertar
                identificação com o público.
              </p>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
              {funFacts.map((f) => (
                <span class="rounded-full bg-sage-light px-4 py-1.5 font-display text-sm font-medium text-sage-dark">{f}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PORTFOLIO -->
    <section id="portfolio" class="relative overflow-hidden bg-pink-light py-20">
      <div class="relative z-10 mx-auto max-w-6xl px-6">
        <h2 data-reveal class="font-display text-4xl font-black text-pink-dark">Portfólio</h2>
        <p data-reveal style="--reveal-delay: 80ms;" class="mt-3 max-w-md text-ink/70">
          Vídeos separados por nicho, com a marca e o formato de cada um — clique pra assistir.
        </p>

        <div id="portfolio-controls" hidden data-reveal style="--reveal-delay: 120ms;" class="mt-8 flex flex-wrap items-center justify-between gap-4">
          <div role="tablist" aria-label="Nichos" data-niche-tabs class="flex flex-wrap gap-2"></div>

          <div data-carousel-nav class="hidden gap-2">
            {[
              { dir: "-1", label: "Vídeos anteriores", d: "M15 18l-6-6 6-6" },
              { dir: "1", label: "Próximos vídeos", d: "M9 18l6-6-6-6" },
            ].map((b) => (
              <button
                type="button"
                data-carousel-dir={b.dir}
                aria-label={b.label}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-pink-dark text-cream transition-opacity hover:opacity-85 disabled:cursor-default disabled:opacity-30"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={b.d} />
                </svg>
              </button>
            ))}
          </div>
        </div>

        <div id="portfolio-list" hidden data-scroll-hint data-niche-list class="-mx-6 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-smooth px-6 py-4 [scrollbar-width:none] sm:mx-0 sm:justify-center-safe sm:gap-6 sm:px-0 [&::-webkit-scrollbar]:hidden"></div>

        <div id="portfolio-empty" data-reveal="scale" style="--reveal-delay: 120ms;" class="stitched mt-8 flex flex-col items-center justify-center gap-3 rounded-2xl py-16 text-pink-dark">
          <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="3" y="5" width="14" height="14" rx="2" />
            <path d="M17 9l4-2v10l-4-2" />
          </svg>
          <p class="font-display text-sm font-semibold">Em breve: os primeiros vídeos do portfólio</p>
        </div>

        <script>
          import type { ApiNiche, ApiVideo, ApiGalleryPhoto, ApiCarouselPost } from "../shared/videos-api";
          import { fetchProjectContent } from "../shared/videos-api";

          const escapeHtml = (s: string) =>
            s.replace(/[&<>"']/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }) as Record<string, string>)[c]);

          const TILTS = ["sm:-translate-y-2 sm:rotate-2", "", "sm:rotate-1", "sm:translate-y-2 sm:-rotate-1"];

          function screenHtml(v: ApiVideo): string {
            if (v.platform === "tiktok") {
              return `<blockquote class="tiktok-embed" cite="${v.url}" style="max-width:605px;min-width:325px;"><section></section></blockquote>`;
            }
            if (v.platform === "instagram") {
              return `
                <blockquote class="instagram-media" data-instgrm-permalink="${v.url}?utm_source=ig_embed&utm_campaign=loading" data-instgrm-version="14"
                  style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:1px; max-width:540px; min-width:326px; padding:0; width:calc(100% - 2px);">
                  <a href="${v.url}" target="_blank" rel="noopener noreferrer">Ver este post no Instagram</a>
                </blockquote>`;
            }
            // youtube/outro (ex.: Canva) — iframe direto, igual ao portfólio de referência
            // (byalacerdah): o Canva só libera ser embutido em iframe na rota /watch?embed —
            // sem o "embed" ele bloqueia por CSP, então garantimos o parâmetro aqui mesmo que
            // quem colou o link no admin não tenha incluído. O iframe captura o toque e trava
            // o scroll no mobile, por isso a capa (tapfacade) que só libera o pointer-events
            // depois do primeiro toque/clique.
            const embedSrc = /[?&]embed(=|&|$)/.test(v.url) ? v.url : v.url + (v.url.includes("?") ? "&embed" : "?embed");
            return `
              <div class="relative h-[608px] w-full" data-canva-stage>
                <iframe loading="lazy" src="${embedSrc}" title="${escapeHtml(v.title || "Vídeo")}" allow="fullscreen" allowfullscreen class="absolute inset-0 h-full w-full border-0" style="pointer-events: none;"></iframe>
                <div class="absolute inset-0 cursor-pointer" data-canva-tapfacade role="button" aria-label="Tocar vídeo" tabindex="0"></div>
              </div>`;
          }

          // mesma estrutura visual do PhoneMockup.astro, montada em JS porque esse componente
          // só existe em build-time — os cards de verdade chegam depois, via fetch no cliente.
          function cardHtml(v: ApiVideo, nicheId: string, tilt: string): string {
            const label = v.title || "Vídeo";
            return `
              <div data-niche="${nicheId}" data-reveal="scale" class="flex w-[62vw] max-w-[260px] shrink-0 snap-center flex-col items-center gap-3 sm:w-[calc(25%-1.125rem)] sm:max-w-none sm:snap-start">
                <div class="relative w-full max-w-[340px] ${tilt}">
                  <div class="relative block">
                    <img src="/images/phone-frame.png" alt="" class="pointer-events-none block w-full select-none" draggable="false" />
                    <div class="absolute overflow-hidden rounded-[6px] bg-white" style="left:21.18%; top:19.08%; width:54.75%; height:61.65%;" data-phone-embed="true">
                      <div class="phone-embed-inner" style="width:342px;">${screenHtml(v)}</div>
                    </div>
                  </div>
                </div>
                <p class="text-center font-display text-base">
                  <span class="font-semibold text-sage-dark">${escapeHtml(label)}</span>${v.tag ? ` <span class="text-ink/60">(${escapeHtml(v.tag)})</span>` : ""}
                </p>
              </div>`;
          }

          // réplica do script de ajuste de escala do PhoneMockup.astro — aquele só roda nos
          // embeds que já existiam no HTML gerado no build, não alcança os que a gente insere
          // depois via fetch, por isso duplicamos aqui pros cards dinâmicos.
          function fitPhoneEmbed(wrap: HTMLElement): boolean {
            const inner = wrap.querySelector<HTMLElement>(".phone-embed-inner");
            const iframe = inner?.querySelector<HTMLIFrameElement>("iframe");
            if (!inner || !iframe) return false;
            inner.style.transformOrigin = "top left";
            const apply = () => {
              const naturalHeight = inner.offsetHeight;
              if (naturalHeight < 100) return;
              const naturalWidth = inner.offsetWidth || 342;
              const scale = wrap.clientWidth / naturalWidth;
              inner.style.transform = `scale(${scale})`;
            };
            apply();
            new ResizeObserver(apply).observe(iframe);
            window.addEventListener("resize", apply);
            return true;
          }
          function watchPhoneEmbeds(root: ParentNode) {
            root.querySelectorAll<HTMLElement>("[data-phone-embed]").forEach((wrap) => {
              if (fitPhoneEmbed(wrap)) return;
              const mo = new MutationObserver(() => {
                if (fitPhoneEmbed(wrap)) mo.disconnect();
              });
              mo.observe(wrap, { childList: true, subtree: true });
            });
          }

          function ensureScript(src: string) {
            if (document.querySelector(`script[src="${src}"]`)) return false;
            const s = document.createElement("script");
            s.src = src;
            s.async = true;
            document.body.appendChild(s);
            return true;
          }
          function processInstagramEmbeds() {
            const w = window as typeof window & { instgrm?: { Embeds: { process(): void } } };
            if (w.instgrm?.Embeds) w.instgrm.Embeds.process();
            else ensureScript("https://www.instagram.com/embed.js");
          }
          function processTiktokEmbeds() {
            document.querySelector('script[src="https://www.tiktok.com/embed.js"]')?.remove();
            ensureScript("https://www.tiktok.com/embed.js");
          }

          const controls = document.getElementById("portfolio-controls");
          const tabsWrap = document.querySelector<HTMLElement>("[data-niche-tabs]");
          const list = document.getElementById("portfolio-list");
          const empty = document.getElementById("portfolio-empty");
          const nav = document.querySelector<HTMLElement>("[data-carousel-nav]");
          const desktop = window.matchMedia("(min-width: 40rem)");

          // o iframe do Canva vem com pointer-events:none (senão ele captura o toque e trava o
          // scroll da página no mobile); um clique na capa libera o iframe pra tocar o vídeo.
          // No document (não só em `list`) porque o mesmo padrão vale pro carrossel também.
          document.addEventListener("click", (e) => {
            const facade = (e.target as HTMLElement).closest<HTMLElement>("[data-canva-tapfacade]");
            if (!facade) return;
            const iframe = facade.previousElementSibling as HTMLIFrameElement | null;
            if (iframe) iframe.style.pointerEvents = "auto";
            facade.remove();
          });

          function updateArrows() {
            if (!list || !nav) return;
            const overflows = desktop.matches && list.scrollWidth > list.clientWidth + 1;
            nav.classList.toggle("hidden", !overflows);
            nav.classList.toggle("flex", overflows);
            const arrows = nav.querySelectorAll<HTMLButtonElement>("[data-carousel-dir]");
            if (arrows[0]) arrows[0].disabled = list.scrollLeft <= 1;
            if (arrows[1]) arrows[1].disabled = list.scrollLeft + list.clientWidth >= list.scrollWidth - 1;
          }

          nav?.addEventListener("click", (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-carousel-dir]");
            if (!btn || !list) return;
            list.scrollBy({ left: Number(btn.dataset.carouselDir) * list.clientWidth });
          });

          tabsWrap?.addEventListener("click", (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-niche-tab]");
            if (!btn || !list) return;
            const niche = btn.dataset.nicheTab;
            tabsWrap.querySelectorAll("[data-niche-tab]").forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
            list.querySelectorAll<HTMLElement>("[data-niche]").forEach((item) => {
              item.hidden = niche !== "todos" && item.dataset.niche !== niche;
            });
            list.scrollTo({ left: 0, behavior: "instant" });
            updateArrows();
          });

          list?.addEventListener("scroll", updateArrows, { passive: true });
          window.addEventListener("resize", updateArrows);

          function renderPortfolio(niches: ApiNiche[]) {
            const withVideos = niches.filter((n) => n.videos.length > 0);
            if (!controls || !tabsWrap || !list || !empty || withVideos.length === 0) return;

            const tabsHtml = [
              `<button type="button" role="tab" data-niche-tab="todos" aria-selected="true" class="rounded-full border border-pink-dark/30 px-4 py-1.5 font-display text-sm font-medium text-pink-dark transition-colors hover:border-pink-dark aria-selected:border-pink-dark aria-selected:bg-pink-dark aria-selected:text-cream">Todos</button>`,
              ...withVideos.map(
                (n) =>
                  `<button type="button" role="tab" data-niche-tab="${n.id}" aria-selected="false" class="rounded-full border border-pink-dark/30 px-4 py-1.5 font-display text-sm font-medium text-pink-dark transition-colors hover:border-pink-dark aria-selected:border-pink-dark aria-selected:bg-pink-dark aria-selected:text-cream">${escapeHtml(n.name)}</button>`,
              ),
            ].join("");
            tabsWrap.innerHTML = tabsHtml;

            let i = 0;
            list.innerHTML = withVideos
              .flatMap((n) => n.videos.map((v) => cardHtml(v, n.id, TILTS[i++ % TILTS.length])))
              .join("");

            empty.hidden = true;
            controls.hidden = false;
            list.hidden = false;

            watchPhoneEmbeds(list);
            if (withVideos.some((n) => n.videos.some((v) => v.platform === "tiktok"))) processTiktokEmbeds();
            if (withVideos.some((n) => n.videos.some((v) => v.platform === "instagram"))) processInstagramEmbeds();
            // os cards chegam depois que o observer de scroll-reveal do Layout já rodou nos
            // elementos que existiam no load — sem isso ficam com opacity:0 pra sempre
            (window as typeof window & { observeReveal?: (els: NodeListOf<Element>) => void }).observeReveal?.(
              list.querySelectorAll("[data-reveal]")
            );
            updateArrows();
          }

          // post de carrossel: só o link do Instagram embeda nativo (com swipe); com um embed do
          // Canva também, mostra o Canva como capa + um link separado pra ver no Instagram — o
          // clique não pode ser capturado de dentro do iframe do Canva (cross-origin).
          function carouselScreenHtml(c: ApiCarouselPost): string {
            if (c.canva_url) {
              const embedSrc = /[?&]embed(=|&|$)/.test(c.canva_url) ? c.canva_url : c.canva_url + (c.canva_url.includes("?") ? "&embed" : "?embed");
              return `
                <div class="relative h-[608px] w-full" data-canva-stage>
                  <iframe loading="lazy" src="${embedSrc}" title="${escapeHtml(c.title || "Carrossel")}" allow="fullscreen" allowfullscreen class="absolute inset-0 h-full w-full border-0" style="pointer-events: none;"></iframe>
                  <div class="absolute inset-0 cursor-pointer" data-canva-tapfacade role="button" aria-label="Tocar" tabindex="0"></div>
                </div>`;
            }
            return `
              <blockquote class="instagram-media" data-instgrm-permalink="${c.instagram_url}?utm_source=ig_embed&utm_campaign=loading" data-instgrm-version="14"
                style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:1px; max-width:540px; min-width:326px; padding:0; width:calc(100% - 2px);">
                <a href="${c.instagram_url}" target="_blank" rel="noopener noreferrer">Ver este post no Instagram</a>
              </blockquote>`;
          }

          function carouselCardHtml(c: ApiCarouselPost, tilt: string): string {
            const label = c.title || "Carrossel";
            return `
              <div data-reveal="scale" class="flex w-[62vw] max-w-[260px] shrink-0 snap-center flex-col items-center gap-3 sm:w-auto sm:max-w-none sm:shrink">
                <div class="relative w-full max-w-[340px] ${tilt}">
                  <div class="relative block">
                    <img src="/images/phone-frame.png" alt="" class="pointer-events-none block w-full select-none" draggable="false" />
                    <div class="absolute overflow-hidden rounded-[6px] bg-white" style="left:21.18%; top:19.08%; width:54.75%; height:61.65%;" data-phone-embed="true">
                      <div class="phone-embed-inner" style="width:342px;">${carouselScreenHtml(c)}</div>
                    </div>
                  </div>
                </div>
                <p class="text-center font-display text-base font-semibold text-sage-dark">${escapeHtml(label)}</p>
                ${c.canva_url ? `<a href="${c.instagram_url}" target="_blank" rel="noopener noreferrer" class="font-display text-xs font-semibold text-pink-dark underline decoration-2 underline-offset-2">Ver no Instagram ↗</a>` : ""}
              </div>`;
          }

          function renderCarousels(carousels: ApiCarouselPost[]) {
            const carouselList = document.getElementById("carousel-list");
            const carouselEmpty = document.getElementById("carousel-empty");
            if (!carouselList || !carouselEmpty || carousels.length === 0) return;

            carouselList.innerHTML = carousels.map((c, i) => carouselCardHtml(c, TILTS[i % TILTS.length])).join("");
            carouselEmpty.hidden = true;
            carouselList.hidden = false;

            watchPhoneEmbeds(carouselList);
            processInstagramEmbeds();
            (window as typeof window & { observeReveal?: (els: NodeListOf<Element>) => void }).observeReveal?.(
              carouselList.querySelectorAll("[data-reveal]")
            );
          }

          // foto da galeria: embed nativo do post (Instagram ou TikTok), igual aos vídeos, ou a
          // arte do Canva direto (iframe) — sem precisar subir arquivo de imagem nenhum.
          function galleryCardHtml(p: ApiGalleryPhoto): string {
            if (p.platform === "canva") {
              const embedSrc = /[?&]embed(=|&|$)/.test(p.url) ? p.url : p.url + (p.url.includes("?") ? "&embed" : "?embed");
              return `
                <div data-reveal="scale" class="social-embed relative aspect-[3/4] w-[300px] max-w-full overflow-hidden rounded-2xl" data-canva-stage>
                  <iframe loading="lazy" src="${embedSrc}" title="${escapeHtml(p.title || "Canva")}" allow="fullscreen" allowfullscreen class="absolute border-0" style="pointer-events: none; left: 50%; top: 0; width: 140%; height: calc(100% + 70px); transform: translateX(-50%);"></iframe>
                  <div class="absolute inset-0 cursor-pointer" data-canva-tapfacade role="button" aria-label="Tocar" tabindex="0"></div>
                </div>`;
            }
            const screen =
              p.platform === "tiktok"
                ? `<blockquote class="tiktok-embed" cite="${p.url}" style="max-width:605px;min-width:325px;"><section></section></blockquote>`
                : `
                  <blockquote class="instagram-media" data-instgrm-permalink="${p.url}?utm_source=ig_embed&utm_campaign=loading" data-instgrm-version="14"
                    style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:1px; max-width:540px; min-width:326px; padding:0; width:calc(100% - 2px);">
                    <a href="${p.url}" target="_blank" rel="noopener noreferrer">Ver este post no Instagram</a>
                  </blockquote>`;
            return `<div data-reveal="scale" class="social-embed w-[300px] max-w-full overflow-hidden rounded-2xl">${screen}</div>`;
          }

          function renderGallery(gallery: ApiGalleryPhoto[]) {
            const grid = document.getElementById("fotos-grid");
            const galleryEmpty = document.getElementById("fotos-empty");
            if (!grid || !galleryEmpty || gallery.length === 0) return;

            grid.className = "mt-10 flex flex-wrap justify-center gap-4";
            grid.innerHTML = gallery.map((p) => galleryCardHtml(p)).join("");
            galleryEmpty.hidden = true;
            grid.hidden = false;

            if (gallery.some((p) => p.platform === "tiktok")) processTiktokEmbeds();
            if (gallery.some((p) => p.platform === "instagram")) processInstagramEmbeds();
            (window as typeof window & { observeReveal?: (els: NodeListOf<Element>) => void }).observeReveal?.(
              grid.querySelectorAll("[data-reveal]")
            );
          }

          fetchProjectContent().then((content) => {
            if (!content) return;
            renderPortfolio(content.niches);
            renderCarousels(content.carousels);
            renderGallery(content.gallery);
          });
        </script>

